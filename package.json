{
  "name": "copilot-web",
  "version": "0.1.0",
  "private": true,
  "description": "A localhost browser interface for GitHub Copilot CLI sessions.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "node-pty": "~1.1.0"
  }
}
